    "run-history",
    "select",
    "settings",
    "sidebar",
    "sign-in",
    "stat",
    "tabs",
    "text-field",
    "theme-toggle",
    "toast",
    "usage-meter"
  ],
  "packages": [
    "@anthropic-ai/sdk@^1.4.0"
  ],
