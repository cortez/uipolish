    "app/sign-in/sign-in.module.css",
    "components/app/app-shell.tsx",
    "components/app/app-sidebar.tsx",
    "components/app/app.module.css",
    "components/app/chat-loading.tsx",
    "components/app/chat-missing.tsx",
    "components/app/chat-view.module.css",
    "components/app/chat-view.tsx",
    "components/app/chat.tsx",
    "components/app/glyphs.tsx",
    "components/app/settings-view.tsx",
    "components/app/settings.module.css",
    "components/app/top-bar.tsx",
    "components/app/use-chat.ts",
    "lib/ai/anthropic.ts",
    "lib/ai/connection.ts",
    "lib/ai/events.ts",
