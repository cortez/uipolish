{
  "name": "ai-chat-app",
  "title": "Chat app",
  "summary": "A working AI chat app for the Next.js App Router: sign-in with an emailed code, a sidebar with workspaces and chat history, chats that stream from Claude, OpenAI or any OpenAI-compatible API (or a mock until one is set) with reasoning, tool steps and sources, and settings for the assistant, billing and members. Auth, storage and the model each sit behind one small file you swap.",
  "type": "template",
  "stage": "wide",
  "version": "0.3.3",
  "dependencies": [
    "agent-settings",
    "alert",
    "avatar",
    "billing",
    "button",
    "chat-app",
    "command-palette",
    "dropdown-menu",
    "empty-state",
    "icons",
    "message-thread",
    "model-picker",
    "prompt-input",
    "response-actions",
    "sidebar",
    "sign-in",
    "tabs",
    "team-members",
    "theme-toggle",
    "toast"
  ],
  "packages": [
    "@anthropic-ai/sdk@^1.4.0"
  ],
  "files": [
    "app/(app)/actions.ts",
    "app/(app)/chat/[id]/loading.tsx",
    "app/(app)/chat/[id]/not-found.tsx",
    "app/(app)/chat/[id]/page.tsx",
    "app/(app)/chat/page.tsx",
    "app/(app)/error.tsx",
    "app/(app)/layout.tsx",
    "app/(app)/settings/page.tsx",
    "app/api/chat/route.ts",
    "app/layout.module.css",
    "app/layout.tsx",
    "app/page.tsx",
    "app/sign-in/actions.ts",
    "app/sign-in/page.tsx",
