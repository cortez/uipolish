# Polar checkout link for donations (a pay-what-you-want product). Unset,
# no Donate link shows in the header or footer.
NEXT_PUBLIC_DONATE_URL=

# Anonymous usage counts (optional). Add Upstash Redis from the Vercel
# Marketplace; it sets these two. Unset, nothing is counted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The private weekly report at /api/stats (Authorization: Bearer <token>).
# Any long random string, e.g. `openssl rand -hex 32`. Unset, the endpoint 404s.
STATS_TOKEN=

# Push the report every Monday (vercel.json cron) to a bot's webhook: a POST
# with JSON { text, content, report }. CRON_SECRET is set by Vercel Cron.
STATS_WEBHOOK_URL=
